{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "minimumReleaseAge": "2 days",
  "customDatasources": {
    "openssl-lts-series": {
      "defaultRegistryUrlTemplate": "https://raw.githubusercontent.com/openssl/release-metadata/main/data.json",
      "format": "json",
      "transformTemplates": [
        "($metadata := $; {\"releases\": $map($filter($keys($metadata), function($version) { $lookup($metadata, $version).lts = true and $match($lookup($metadata, $version).release, /^[0-9]{2} [A-Z][a-z]{2} [0-9]{4}$/) }), function($version) { {\"version\": $version} })})"
      ]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/.github/workflows/github-actions-lint.yml/",
        "/.github/workflows/go.yml/"
      ],
      "datasourceTemplate": "golang-version",
      "depNameTemplate": "go",
      "matchStrings": [
        "go-version: \"?(?<currentValue>[0-9]*.[0-9]*.[0-9]*)\"?"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/.github/workflows/security.yml/"
      ],
      "datasourceTemplate": "golang-version",
      "depNameTemplate": "go-security",
      "matchStrings": [
        "go-version: \"?(?<currentValue>[0-9]*.[0-9]*.[0-9]*)\"?"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/.github/workflows/release.yml/"
      ],
      "datasourceTemplate": "golang-version",
      "depNameTemplate": "go",
      "matchStrings": [
        "go-version: \"?(?<currentValue>[0-9]*.[0-9]*.[0-9]*)\"?"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/osv-scanner.toml/"
      ],
      "datasourceTemplate": "golang-version",
      "depNameTemplate": "go-security",
      "matchStrings": [
        "GoVersionOverride = \"(?<currentValue>[0-9]*.[0-9]*.[0-9]*)\""
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/builder/const.go/"
      ],
      "extractVersionTemplate": "^v(?<version>.*)$",
      "matchStrings": [
        "datasource=(?<datasource>.*?) depName=(?<depName>.*?)( versioning=(?<versioning>.*?))?\n.* \"(?<currentValue>[0-9.]*)\""
      ],
      "versioningTemplate": "{{#if versioning}}{{versioning}}{{else}}semver{{/if}}"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/builder/const.go/"
      ],
      "extractVersionTemplate": "^release-(?<version>[0-9]*.[0-9]*[02468].[0-9]*)$",
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "nginx/nginx",
      "matchStrings": [
        "NginxVersion\\s+=\\s\"(?<currentValue>[0-9.]*)\""
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/builder/const.go/"
      ],
      "extractVersionTemplate": "^release-(?<version>[0-9]*.[0-9]*[02468].[0-9]*)$",
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "freenginx/nginx",
      "matchStrings": [
        "FreenginxVersion\\s+=\\s\"(?<currentValue>[0-9.]*)\""
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/builder/const.go/"
      ],
      "extractVersionTemplate": "^v(?<version>.*)$",
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "madler/zlib",
      "matchStrings": [
        "ZlibVersion\\s+=\\s\"(?<currentValue>[0-9.]*)\""
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/builder/const.go/"
      ],
      "extractVersionTemplate": "^pcre2-(?<version>[0-9]*\\.[0-9]*)$",
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "PCRE2Project/pcre2",
      "matchStrings": [
        "PcreVersion\\s+=\\s\"(?<currentValue>[0-9.]*)\""
      ]
    },
    {
      "customType": "regex",
      "description": "LibreSSL tags include development releases. Confirm stable status on https://www.libressl.org/ before approving updates.",
      "managerFilePatterns": [
        "/builder/const.go/"
      ],
      "extractVersionTemplate": "^v(?<version>[0-9]*.[0-9]*.[0-9]*)$",
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "libressl/portable",
      "matchStrings": [
        "LibreSSLVersion\\s+=\\s\"(?<currentValue>[0-9.]*)\""
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/builder/const.go/"
      ],
      "extractVersionTemplate": "^openssl-(?<version>.*)$",
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "openssl/openssl",
      "matchStrings": [
        "OpenSSLVersion\\s+=\\s\"(?<currentValue>[0-9.]*)\""
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^renovate\\.json$/"
      ],
      "matchStrings": [
        "(?<prefix>\"description\": \"OpenSSL LTS only\\. See https://openssl-library\\.org/roadmap/index\\.html\"[\\s\\S]*?\"allowedVersions\": \"/\\^)(?<major>[0-9]+)[\\\\][\\\\][.](?<minor>[0-9]+)"
      ],
      "currentValueTemplate": "{{{major}}}.{{{minor}}}",
      "autoReplaceStringTemplate": "{{{prefix}}}{{{newMajor}}}\\\\.{{{newMinor}}}",
      "datasourceTemplate": "custom.openssl-lts-series",
      "depNameTemplate": "openssl-lts-series",
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/builder/const.go/"
      ],
      "extractVersionTemplate": "^v(?<version>[0-9.]*)$",
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "openresty/openresty",
      "matchStrings": [
        "OpenRestyVersion\\s+=\\s\"(?<currentValue>[0-9.]*)\""
      ]
    }
  ],
  "packageRules": [
    {
      "matchDepNames": [
        "go-security"
      ],
      "groupName": "go-version-security"
    },
    {
      "description": "OpenSSL LTS only. See https://openssl-library.org/roadmap/index.html",
      "matchDatasources": [
        "github-tags"
      ],
      "matchPackageNames": [
        "openssl/openssl"
      ],
      "allowedVersions": "/^3\\.5\\.[0-9]+$/"
    },
    {
      "description": "Track changes to the latest released OpenSSL LTS series.",
      "matchDatasources": [
        "custom.openssl-lts-series"
      ],
      "matchPackageNames": [
        "openssl-lts-series"
      ],
      "minimumReleaseAge": "0 days"
    },
    {
      "description": "Confirm that LibreSSL is stable before approving updates. See https://www.libressl.org/",
      "matchDatasources": [
        "github-tags"
      ],
      "matchPackageNames": [
        "libressl/portable"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "matchDatasources": [
        "github-tags"
      ],
      "matchPackageNames": [
        "openresty/openresty"
      ],
      "versioning": "regex:^(?<major>[0-9]+)\\.(?<minor>[0-9]+)\\.(?<patch>[0-9]+)(\\.(?<build>[0-9]*))?$"
    }
  ],
  "postUpdateOptions": [
    "gomodTidy",
    "gomodUpdateImportPaths"
  ]
}
